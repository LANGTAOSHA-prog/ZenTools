<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 680 400" font-family="'Inter',-apple-system,'PingFang SC','Microsoft YaHei',sans-serif">
<defs><linearGradient id="bg" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stop-color="#0f172a"/><stop offset="100%" stop-color="#070b18"/></linearGradient><linearGradient id="accent" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#3b82f6"/><stop offset="100%" stop-color="#8b5cf6"/></linearGradient></defs>
<rect width="680" height="400" fill="url(#bg)" rx="14"/>
<text x="30" y="42" fill="#f0f4ff" font-size="20" font-weight="700">🧾 税率计算器</text><text x="30" y="66" fill="#6b7a9f" font-size="13">计算个税和增值税，含税价与不含税价转换。</text>
<rect x="30" y="85" width="620" height="290" fill="rgba(14,22,41,0.8)" rx="14" stroke="rgba(255,255,255,0.06)" stroke-width="1"/>
<rect x="50" y="100" width="120" height="36" fill="url(#accent)" rx="8"/><text x="110" y="123" fill="#fff" font-size="13" font-weight="600" text-anchor="middle">个税计算</text>
<rect x="180" y="100" width="100" height="36" fill="rgba(255,255,255,0.06)" rx="8"/><text x="230" y="123" fill="#6b7a9f" font-size="13" text-anchor="middle">增值税</text>
<text x="50" y="160" fill="#f0f4ff" font-size="14" font-weight="700">税前月收入: 15,000 元</text>
<text x="50" y="185" fill="#f0f4ff" font-size="14" font-weight="700">社保公积金: 1,500 元</text>
<text x="50" y="210" fill="#f0f4ff" font-size="14" font-weight="700">专项附加扣除: 2,000 元</text>
<rect x="50" y="230" width="580" height="110" fill="#0f1a35" rx="10" stroke="rgba(0,229,255,0.15)" stroke-width="1"/>
<text x="70" y="255" fill="#6b7a9f" font-size="13">应纳税所得额: <tspan fill="#f0f4ff" font-weight="700">6,500</tspan> 元</text>
<text x="70" y="282" fill="#6b7a9f" font-size="13">应缴个税: <tspan fill="#00e5ff" font-weight="700">240</tspan> 元</text>
<text x="70" y="310" fill="#6b7a9f" font-size="13">税后收入: <tspan fill="#34d399" font-weight="700">13,260</tspan> 元</text>
<text x="70" y="332" fill="#6b7a9f" font-size="11">个税起征点: 5000元/月 | 累计预扣预缴</text>
</svg>
