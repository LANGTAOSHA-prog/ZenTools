<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>图片工具箱 - ZenTools</title>

<!-- 引入统一数据源 -->
<script src="/assets/js/tools-data.js"></script>

<style>
:root{
    --bg:#0f172a;
    --card:#1e293b;
    --card-hover:#334155;
    --text:#f8fafc;
    --muted:#94a3b8;
    --primary:#3b82f6;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
}

body{
    background:var(--bg);
    color:var(--text);
    min-height:100vh;
}

.container{
    max-width:1200px;
    margin:auto;
    padding:30px 20px;
}

.header{
    text-align:center;
    margin-bottom:40px;
}

.header h1{
    font-size:2.5rem;
    margin-bottom:15px;
}

.header p{
    color:var(--muted);
    font-size:1.1rem;
}

.back{
    display:inline-block;
    margin-bottom:30px;
    color:white;
    text-decoration:none;
    background:var(--primary);
    padding:10px 18px;
    border-radius:10px;
}

.back:hover{
    background:#2563eb;
}

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:20px;
}

.card{
    background:var(--card);
    border-radius:16px;
    padding:25px;
    transition:.3s;
    text-decoration:none;
    color:white;
    display:block;
}

.card:hover{
    transform:translateY(-5px);
    background:var(--card-hover);
}

.icon{
    font-size:40px;
    margin-bottom:15px;
}

.card h3{
    margin-bottom:10px;
}

.card p{
    color:var(--muted);
    line-height:1.6;
}

.empty-msg{
    text-align:center;
    padding:60px 20px;
    background:var(--card);
    border-radius:16px;
    color:var(--muted);
}

.footer{
    margin-top:50px;
    text-align:center;
    color:var(--muted);
}

@media(max-width:768px){
    .header h1{
        font-size:2rem;
    }
}
</style>
</head>
<body>

<div class="container">

<a href="/" class="back">← 返回首页</a>

<div class="header">
    <h1>🖼 图片工具箱</h1>
    <p>在线图片处理工具集合，无需安装软件</p>
</div>

<div class="grid" id="toolsGrid">
    <!-- 动态加载工具卡片 -->
    <div class="empty-msg">加载中...</div>
</div>

<div class="footer">
    © 2026 ZenTools 图片工具箱
</div>

</div>

<script>
// 动态渲染图片工具卡片
function renderImageTools() {
    const container = document.getElementById('toolsGrid');
    if (!container) return;
    
    // 检查 toolsData 是否存在
    if (typeof toolsData === 'undefined') {
        container.innerHTML = '<div class="empty-msg">❌ 数据加载失败，请检查 assets/js/tools-data.js 是否存在</div>';
        return;
    }
    
    // 筛选分类为 "图片工具" 的工具
    const imageTools = toolsData.filter(tool => tool.category === '图片工具');
    
    if (imageTools.length === 0) {
        container.innerHTML = '<div class="empty-msg">📭 暂无图片工具，敬请期待</div>';
        return;
    }
    
    // 生成工具卡片 HTML
    let toolsHtml = '';
    for (const tool of imageTools) {
        // 处理 URL：如果是相对路径，基于当前页面位置补全
        let toolUrl = tool.url;
        if (toolUrl && !toolUrl.startsWith('http') && !toolUrl.startsWith('/')) {
            // 图片工具箱页面在 /image/ 目录下，所以相对路径直接使用
            toolUrl = tool.url;
        }
        
        toolsHtml += `
            <a href="${toolUrl}" class="card">
                <div class="icon">${tool.icon || '🖼️'}</div>
                <h3>${escapeHtml(tool.name)}</h3>
                <p>${escapeHtml(tool.description || '点击使用工具')}</p>
            </a>
        `;
    }
    
    container.innerHTML = toolsHtml;
}

// 简单的防XSS辅助函数
function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/[&<>]/g, function(m) {
        if (m === '&') return '&amp;';
        if (m === '<') return '&lt;';
        if (m === '>') return '&gt;';
        return m;
    });
}

// 页面加载完成后渲染
document.addEventListener('DOMContentLoaded', renderImageTools);
</script>

</body>
</html>