<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>图片工具箱 - ZenTools</title>
<script src="/assets/js/tools-data.js"></script>
<!-- 引入统一数据源 -->
<script src="/assets/js/tools-data.js"></script>

<style>
:root{
    --bg:#0f172a;
    --card:#1e293b;
    --card-hover:#334155;
    --text:#f8fafc;
    --muted:#94a3b8;
    --primary:#3b82f6;
}

*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
}

body{
    background:var(--bg);
    color:var(--text);
    min-height:100vh;
}

.container{
    max-width:1200px;
    margin:auto;
    padding:30px 20px;
}

.header{
    text-align:center;
    margin-bottom:40px;
}

.header h1{
    font-size:2.5rem;
    margin-bottom:15px;
}

.header p{
    color:var(--muted);
    font-size:1.1rem;
}

.back{
    display:inline-block;
    margin-bottom:30px;
    color:white;
    text-decoration:none;
    background:var(--primary);
    padding:10px 18px;
    border-radius:10px;
}

.back:hover{
    background:#2563eb;
}

.grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(280px,1fr));
    gap:20px;
}

.card{
    background:var(--card);
    border-radius:16px;
    padding:25px;
    transition:.3s;
    text-decoration:none;
    color:white;
    display:block;
}

.card:hover{
    transform:translateY(-5px);
    background:var(--card-hover);
}

.icon{
    font-size:40px;
    margin-bottom:15px;
}

.card h3{
    margin-bottom:10px;
}

.card p{
    color:var(--muted);
    line-height:1.6;
}

.empty-msg{
    text-align:center;
    padding:60px 20px;
    background:var(--card);
    border-radius:16px;
    color:var(--muted);
}

.footer{
    margin-top:50px;
    text-align:center;
    color:var(--muted);
}

@media(max-width:768px){
    .header h1{
        font-size:2rem;
    }
}
</style>
</head>
<body>

<div class="container">

<a href="/" class="back">← 返回首页</a>

<div class="header">
    <h1>🖼 图片工具箱</h1>
    <p>在线图片处理工具集合，无需安装软件</p>
</div>

<div class="grid" id="toolsGrid">
    <!-- 动态加载工具卡片 -->
    <div class="empty-msg">加载中...</div>
</div>

<div class="footer">
    © 2026 ZenTools 图片工具箱
</div>

</div>

<script>
  // 年份自动更新
  document.getElementById('year').textContent = new Date().getFullYear();

  // 主题切换
  function initTheme() {
    const s = localStorage.getItem('zh_theme') || 'dark';
    document.documentElement.setAttribute('data-theme', s);
    const btn = document.getElementById('themeBtn');
    if (btn) btn.textContent = s === 'dark' ? '☀️ 亮色' : '🌙 暗色';
  }
  
  function toggleTheme() {
    const c = document.documentElement.getAttribute('data-theme');
    const n = c === 'dark' ? 'light' : 'dark';
    document.documentElement.setAttribute('data-theme', n);
    localStorage.setItem('zh_theme', n);
    const btn = document.getElementById('themeBtn');
    if (btn) btn.textContent = n === 'dark' ? '☀️ 亮色' : '🌙 暗色';
  }
  
  initTheme();

  // 返回顶部按钮
  const bt = document.getElementById('backTop');
  if (bt) {
    window.addEventListener('scroll', () => bt.classList.toggle('visible', scrollY > 400), { passive: true });
  }

  // ========== 动态渲染工具卡片（从 tools-data.js 读取）==========
  // 等待 DOM 加载完成
  document.addEventListener('DOMContentLoaded', function() {
    const toolsContainer = document.querySelector('.tools-grid');
    if (!toolsContainer) return;
    
    // 检查 toolsData 是否存在（由 assets/js/tools-data.js 定义）
    if (typeof toolsData === 'undefined') {
      console.warn('toolsData 未加载，请确保 assets/js/tools-data.js 已引入');
      return;
    }
    
    // 选取需要展示的工具（featured 为 true 的工具，最多显示 8 个）
    const featuredTools = toolsData.filter(tool => tool.featured === true).slice(0, 8);
    
    // 如果没有 featured 标记，则显示前 8 个
    const toolsToShow = featuredTools.length > 0 ? featuredTools : toolsData.slice(0, 8);
    
    // 生成工具卡片 HTML
    let toolsHtml = '';
    for (const tool of toolsToShow) {
      // 处理 URL：如果已经是完整路径则直接使用，否则补全 / 前缀
      let toolUrl = tool.url;
      if (toolUrl && !toolUrl.startsWith('http') && !toolUrl.startsWith('/')) {
        toolUrl = '/' + toolUrl;
      }
      
      toolsHtml += `
        <a class="tool-card" href="${toolUrl}" target="_blank" title="${tool.description || tool.name}">
          <div class="tool-emoji">${tool.icon || '🔧'}</div>
          <div class="tool-name">${escapeHtml(tool.name)}</div>
          <div class="tool-desc">${escapeHtml(tool.description || '点击使用工具')}</div>
          <span class="tool-tag">${escapeHtml(tool.category || '工具')}</span>
        </a>
      `;
    }
    
    // 添加"查看全部"卡片
    toolsHtml += `
      <a class="tool-card" href="/plugins-preview.html" target="_blank" title="查看全部工具">
        <div class="tool-emoji">⭐</div>
        <div class="tool-name">查看全部</div>
        <div class="tool-desc">浏览更多工具</div>
        <span class="tool-tag">工具箱</span>
      </a>
    `;
    
    toolsContainer.innerHTML = toolsHtml;
  });
  
  // 简单的防XSS辅助函数
  function escapeHtml(str) {
    if (!str) return '';
    return str.replace(/[&<>]/g, function(m) {
      if (m === '&') return '&amp;';
      if (m === '<') return '&lt;';
      if (m === '>') return '&gt;';
      return m;
    });
  }
</script>