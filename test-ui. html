<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ZenTools 2.0 · 科技风测试</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700;14..32,800&display=swap" rel="stylesheet" />
    <style>
        /* ═══ 全局重置 & 变量 ═══ */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        :root {
            --bg-primary: #060b18;
            --bg-secondary: #0b1428;
            --bg-card: rgba(255, 255, 255, 0.03);
            --border-glow: rgba(0, 180, 255, 0.15);
            --border-subtle: rgba(255, 255, 255, 0.05);
            --text-primary: #f0f4ff;
            --text-secondary: #8899bb;
            --text-muted: #4a5a7a;
            --accent-cyan: #00d4ff;
            --accent-blue: #3b82f6;
            --accent-purple: #8b5cf6;
            --accent-pink: #ec4899;
            --shadow-glow: 0 0 40px rgba(0, 180, 255, 0.08);
            --radius-card: 16px;
            --radius-pill: 999px;
            --transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        body {
            font-family: 'Inter', -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
            background: var(--bg-primary);
            color: var(--text-primary);
            min-height: 100vh;
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
        }

        /* ═══ 背景装饰 ═══ */
        .bg-glow {
            position: fixed;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            overflow: hidden;
        }

        .bg-glow .orb {
            position: absolute;
            border-radius: 50%;
            filter: blur(100px);
            opacity: 0.3;
        }

        .bg-glow .orb-1 {
            width: 500px;
            height: 500px;
            background: var(--accent-cyan);
            top: -200px;
            left: -150px;
            animation: floatOrb 12s ease-in-out infinite;
        }

        .bg-glow .orb-2 {
            width: 400px;
            height: 400px;
            background: var(--accent-purple);
            bottom: -150px;
            right: -100px;
            animation: floatOrb 16s ease-in-out infinite reverse;
        }

        .bg-glow .orb-3 {
            width: 300px;
            height: 300px;
            background: var(--accent-pink);
            top: 40%;
            left: 50%;
            transform: translateX(-50%);
            opacity: 0.15;
            animation: floatOrb 20s ease-in-out infinite;
        }

        @keyframes floatOrb {
            0%,
            100% {
                transform: translate(0, 0) scale(1);
            }
            33% {
                transform: translate(30px, -40px) scale(1.1);
            }
            66% {
                transform: translate(-20px, 30px) scale(0.9);
            }
        }

        /* ═══ 网格线 ═══ */
        .grid-lines {
            position: fixed;
            inset: 0;
            z-index: 0;
            pointer-events: none;
            background-image:
                linear-gradient(rgba(0, 180, 255, 0.03) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 180, 255, 0.03) 1px, transparent 1px);
            background-size: 60px 60px;
        }

        /* ═══ 内容容器 ═══ */
        .app {
            position: relative;
            z-index: 1;
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 24px 60px;
        }

        /* ═══ 导航栏 ═══ */
        .navbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px 0;
            border-bottom: 1px solid var(--border-subtle);
            margin-bottom: 48px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .nav-left {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .nav-logo {
            font-size: 22px;
            font-weight: 800;
            background: linear-gradient(135deg, var(--accent-cyan), var(--accent-blue));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            letter-spacing: -0.5px;
        }

        .nav-logo .badge {
            font-size: 10px;
            font-weight: 600;
            background: rgba(0, 180, 255, 0.15);
            color: var(--accent-cyan);
            padding: 2px 10px;
            border-radius: var(--radius-pill);
            margin-left: 8px;
            letter-spacing: 0.5px;
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 6px;
            list-style: none;
            flex-wrap: wrap;
        }

        .nav-links a {
            color: var(--text-secondary);
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
            padding: 8px 16px;
            border-radius: var(--radius-pill);
            transition: var(--transition);
            position: relative;
        }

        .nav-links a:hover {
            color: var(--text-primary);
            background: rgba(255, 255, 255, 0.04);
        }

        .nav-links a.active {
            color: var(--accent-cyan);
            background: rgba(0, 180, 255, 0.08);
        }

        .nav-links a .dot {
            display: inline-block;
            width: 6px;
            height: 6px;
            background: var(--accent-cyan);
            border-radius: 50%;
            margin-left: 4px;
            box-shadow: 0 0 10px var(--accent-cyan);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0%,
            100% {
                opacity: 1;
            }
            50% {
                opacity: 0.3;
            }
        }

        .nav-right {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .nav-btn {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-subtle);
            color: var(--text-secondary);
            padding: 8px 18px;
            border-radius: var(--radius-pill);
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: var(--transition);
            font-family: inherit;
        }

        .nav-btn:hover {
            background: rgba(255, 255, 255, 0.08);
            color: var(--text-primary);
            border-color: rgba(255, 255, 255, 0.1);
        }

        .nav-btn-primary {
            background: linear-gradient(135deg, var(--accent-cyan), var(--accent-blue));
            border: none;
            color: #fff;
        }

        .nav-btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 30px rgba(0, 180, 255, 0.25);
            background: linear-gradient(135deg, var(--accent-cyan), var(--accent-purple));
        }

        /* ═══ Hero ═══ */
        .hero {
            text-align: center;
            padding: 40px 0 50px;
        }

        .hero-tag {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            background: rgba(0, 180, 255, 0.08);
            border: 1px solid rgba(0, 180, 255, 0.12);
            padding: 6px 18px 6px 14px;
            border-radius: var(--radius-pill);
            font-size: 12px;
            font-weight: 600;
            color: var(--accent-cyan);
            letter-spacing: 0.5px;
            margin-bottom: 24px;
        }

        .hero-tag .live-dot {
            width: 8px;
            height: 8px;
            background: #22c55e;
            border-radius: 50%;
            animation: pulse 1.5s infinite;
        }

        .hero h1 {
            font-size: clamp(40px, 6vw, 72px);
            font-weight: 900;
            letter-spacing: -1.5px;
            line-height: 1.05;
            margin-bottom: 16px;
        }

        .hero h1 .hl {
            background: linear-gradient(135deg, var(--accent-cyan), var(--accent-purple));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .hero p {
            font-size: 18px;
            color: var(--text-secondary);
            max-width: 560px;
            margin: 0 auto 32px;
        }

        .hero-actions {
            display: flex;
            justify-content: center;
            gap: 14px;
            flex-wrap: wrap;
        }

        .btn-hero {
            padding: 14px 36px;
            border-radius: var(--radius-pill);
            font-size: 15px;
            font-weight: 600;
            border: none;
            cursor: pointer;
            transition: var(--transition);
            font-family: inherit;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }

        .btn-hero-primary {
            background: linear-gradient(135deg, var(--accent-cyan), var(--accent-blue));
            color: #fff;
            box-shadow: 0 0 40px rgba(0, 180, 255, 0.15);
        }

        .btn-hero-primary:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 50px rgba(0, 180, 255, 0.25);
        }

        .btn-hero-secondary {
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid var(--border-subtle);
            color: var(--text-primary);
        }

        .btn-hero-secondary:hover {
            background: rgba(255, 255, 255, 0.08);
            transform: translateY(-3px);
        }

        /* ═══ 工具卡片网格 ═══ */
        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
            flex-wrap: wrap;
            gap: 12px;
        }

        .section-header h2 {
            font-size: 22px;
            font-weight: 700;
            letter-spacing: -0.3px;
        }

        .section-header .see-all {
            color: var(--text-secondary);
            font-size: 14px;
            font-weight: 500;
            text-decoration: none;
            transition: var(--transition);
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .section-header .see-all:hover {
            color: var(--accent-cyan);
        }

        .tools-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 20px;
        }

        .tool-card {
            background: var(--bg-card);
            border: 1px solid var(--border-subtle);
            border-radius: var(--radius-card);
            padding: 24px 20px 20px;
            text-align: center;
            text-decoration: none;
            color: inherit;
            transition: var(--transition);
            position: relative;
            overflow: hidden;
            backdrop-filter: blur(4px);
        }

        .tool-card::before {
            content: '';
            position: absolute;
            inset: 0;
            border-radius: inherit;
            padding: 1px;
            background: linear-gradient(135deg, transparent, rgba(0, 180, 255, 0.1), transparent);
            -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
            -webkit-mask-composite: xor;
            mask-composite: exclude;
            pointer-events: none;
            opacity: 0;
            transition: var(--transition);
        }

        .tool-card:hover {
            transform: translateY(-6px);
            background: rgba(255, 255, 255, 0.06);
            border-color: rgba(0, 180, 255, 0.2);
            box-shadow: var(--shadow-glow);
        }

        .tool-card:hover::before {
            opacity: 1;
        }

        .tool-card .emoji {
            font-size: 38px;
            display: block;
            margin-bottom: 12px;
        }

        .tool-card .name {
            font-size: 15px;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .tool-card .desc {
            font-size: 13px;
            color: var(--text-secondary);
            line-height: 1.5;
        }

        .tool-card .tag {
            display: inline-block;
            margin-top: 12px;
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            color: var(--accent-cyan);
            background: rgba(0, 180, 255, 0.08);
            padding: 4px 14px;
            border-radius: var(--radius-pill);
        }

        .tool-card .tag.new {
            color: #22c55e;
            background: rgba(34, 197, 94, 0.08);
        }

        /* ═══ 统计条 ═══ */
        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 16px;
            margin-top: 48px;
            padding: 24px 0;
            border-top: 1px solid var(--border-subtle);
            border-bottom: 1px solid var(--border-subtle);
        }

        .stat-item {
            text-align: center;
        }

        .stat-item .number {
            font-size: 28px;
            font-weight: 800;
            background: linear-gradient(135deg, var(--accent-cyan), var(--accent-blue));
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
        }

        .stat-item .label {
            font-size: 13px;
            color: var(--text-secondary);
        }

        /* ═══ Footer ═══ */
        .footer {
            margin-top: 60px;
            padding-top: 24px;
            border-top: 1px solid var(--border-subtle);
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 16px;
            font-size: 13px;
            color: var(--text-muted);
        }

        .footer a {
            color: var(--text-secondary);
            text-decoration: none;
            transition: var(--transition);
        }

        .footer a:hover {
            color: var(--accent-cyan);
        }

        .footer-links {
            display: flex;
            gap: 20px;
        }

        /* ═══ 响应式 ═══ */
        @media (max-width: 768px) {
            .navbar {
                flex-direction: column;
                align-items: stretch;
                gap: 12px;
            }

            .nav-left {
                justify-content: center;
            }

            .nav-links {
                justify-content: center;
            }

            .nav-right {
                justify-content: center;
            }

            .hero h1 {
                font-size: 32px;
            }

            .tools-grid {
                grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
                gap: 14px;
            }

            .stats {
                grid-template-columns: repeat(2, 1fr);
            }

            .footer {
                flex-direction: column;
                text-align: center;
            }

            .footer-links {
                justify-content: center;
            }
        }

        @media (max-width: 480px) {
            .app {
                padding: 0 16px 40px;
            }

            .nav-links a {
                font-size: 12px;
                padding: 6px 12px;
            }

            .tools-grid {
                grid-template-columns: 1fr 1fr;
                gap: 12px;
            }

            .tool-card {
                padding: 18px 14px 16px;
            }

            .tool-card .emoji {
                font-size: 28px;
            }

            .tool-card .name {
                font-size: 13px;
            }

            .tool-card .desc {
                font-size: 11px;
            }
        }
    </style>
</head>
<body>

    <!-- ═══ 背景装饰 ═══ -->
    <div class="bg-glow">
        <div class="orb orb-1"></div>
        <div class="orb orb-2"></div>
        <div class="orb orb-3"></div>
    </div>
    <div class="grid-lines"></div>

    <!-- ═══ 主应用 ═══ -->
    <div class="app">

        <!-- ═══ 导航栏 ═══ -->
        <nav class="navbar">
            <div class="nav-left">
                <div class="nav-logo">
                    ZenTools
                    <span class="badge">2.0</span>
                </div>
            </div>

            <ul class="nav-links">
                <li><a href="#" class="active">首页</a></li>
                <li><a href="#tools">工具 <span class="dot"></span></a></li>
                <li><a href="#">分类</a></li>
                <li><a href="#">教程</a></li>
                <li><a href="#">关于</a></li>
            </ul>

            <div class="nav-right">
                <button class="nav-btn">🌙 暗色</button>
                <button class="nav-btn nav-btn-primary">开始使用</button>
            </div>
        </nav>

        <!-- ═══ Hero ═══ -->
        <section class="hero">
            <div class="hero-tag">
                <span class="live-dot"></span>
                数据驱动 · 分类架构 · 本地优先
            </div>

            <h1>
                精简 · 高效 · <span class="hl">ZenTools</span>
            </h1>
            <p>
                基于 ZT-DCA 规范构建的在线工具集，所有工具本地运行，隐私安全。
            </p>

            <div class="hero-actions">
                <a href="#tools" class="btn-hero btn-hero-primary">
                    🚀 探索工具
                </a>
                <a href="#" class="btn-hero btn-hero-secondary">
                    📖 开发守则
                </a>
            </div>
        </section>

        <!-- ═══ 工具网格 ═══ -->
        <div id="tools">
            <div class="section-header">
                <h2>🔥 热门工具</h2>
                <a href="#" class="see-all">查看全部 →</a>
            </div>

            <div class="tools-grid" id="toolsGrid">
                <!-- 由 JavaScript 动态生成 -->
                <div style="grid-column:1/-1; text-align:center; padding:40px; color:#4a5a7a;">
                    ⏳ 加载工具中...
                </div>
            </div>
        </div>

        <!-- ═══ 统计 ═══ -->
        <div class="stats">
            <div class="stat-item">
                <div class="number">6+</div>
                <div class="label">工具总数</div>
            </div>
            <div class="stat-item">
                <div class="number">10+</div>
                <div class="label">分类</div>
            </div>
            <div class="stat-item">
                <div class="number">100%</div>
                <div class="label">本地运行</div>
            </div>
            <div class="stat-item">
                <div class="number">v2.0</div>
                <div class="label">ZT-DCA</div>
            </div>
        </div>

        <!-- ═══ Footer ═══ -->
        <footer class="footer">
            <div>© 2026 <a href="/">ZenTools</a> · 数据驱动分类架构</div>
            <div class="footer-links">
                <a href="#">GitHub</a>
                <a href="#">开发守则</a>
                <a href="https://beian.miit.gov.cn/" target="_blank">鲁ICP备2026030242号-1</a>
            </div>
        </footer>

    </div>

    <!-- ═══ 脚本 ═══ -->
    <script>
        (function() {
            // 从 JSON 加载工具数据
            fetch('/data/tools-data.json')
                .then(res => {
                    if (!res.ok) throw new Error('JSON 加载失败');
                    return res.json();
                })
                .then(data => {
                    if (!data.tools || data.tools.length === 0) throw new Error('工具数据为空');

                    const container = document.getElementById('toolsGrid');
                    if (!container) return;

                    // 取 featured 工具，最多 6 个
                    const featured = data.tools.filter(t => t.featured === true).slice(0, 6);
                    const tools = featured.length > 0 ? featured : data.tools.slice(0, 6);

                    let html = '';
                    for (const tool of tools) {
                        const tag = tool.new ? 'NEW' : (tool.category || '工具');
                        const tagClass = tool.new ? 'new' : '';
                        html += `
                            <a class="tool-card" href="${tool.url}" target="_blank">
                                <span class="emoji">${tool.icon || '🔧'}</span>
                                <div class="name">${tool.name}</div>
                                <div class="desc">${tool.description || '点击使用'}</div>
                                <span class="tag ${tagClass}">${tag}</span>
                            </a>
                        `;
                    }

                    container.innerHTML = html;
                    console.log('✅ ZT-DCA 测试: 成功渲染 ' + tools.length + ' 个工具');
                })
                .catch(err => {
                    console.warn('⚠️ ZT-DCA 测试: 使用备用数据', err);
                    const container = document.getElementById('toolsGrid');
                    if (container) {
                        container.innerHTML = `
                            <a class="tool-card" href="/pdf/index.html">
                                <span class="emoji">📄</span>
                                <div class="name">PDF 工具</div>
                                <div class="desc">PDF 转图片、图片转 PDF</div>
                                <span class="tag">PDF</span>
                            </a>
                            <a class="tool-card" href="/image/compress.html">
                                <span class="emoji">🖼️</span>
                                <div class="name">图片压缩</div>
                                <div class="desc">压缩 JPG、PNG 图片体积</div>
                                <span class="tag new">NEW</span>
                            </a>
                            <a class="tool-card" href="#">
                                <span class="emoji">🔊</span>
                                <div class="name">文字转语音</div>
                                <div class="desc">输入文字即可朗读</div>
                                <span class="tag">音频</span>
                            </a>
                            <a class="tool-card" href="#">
                                <span class="emoji">🌍</span>
                                <div class="name">世界时间</div>
                                <div class="desc">查看不同时区时间</div>
                                <span class="tag">生活</span>
                            </a>
                            <a class="tool-card" href="#">
                                <span class="emoji">💱</span>
                                <div class="name">汇率换算</div>
                                <div class="desc">常见货币兑换估算</div>
                                <span class="tag">金融</span>
                            </a>
                            <a class="tool-card" href="#">
                                <span class="emoji">🤖</span>
                                <div class="name">AI 工具导航</div>
                                <div class="desc">AI 写作、绘图工具入口</div>
                                <span class="tag">AI</span>
                            </a>
                        `;
                    }
                });
        })();
    </script>

</body>
</html>